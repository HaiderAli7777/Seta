<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_customer_statement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customer.statement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Customer Statements" id="customer_statement_settings">
                    <setting id="statement_texts" company_dependent="1" string="Statement Texts"
                             help="Printed above and below the transactions on customer statements">
                        <div class="content-group">
                            <div class="mt8 fw-bold">Introduction</div>
                            <field name="statement_intro" class="oe_account_terms"
                                   placeholder="e.g. Please find below the statement of your account..."/>
                            <div class="mt8 fw-bold">Payment instructions</div>
                            <field name="statement_payment_terms" class="oe_account_terms"
                                   placeholder="e.g. Please pay by bank transfer within 30 days..."/>
                        </div>
                    </setting>
                    <setting id="statement_bank_accounts" company_dependent="1" string="Bank Accounts"
                             help="Printed on statements. Leave empty to print all bank accounts of the company.">
                        <field name="statement_bank_ids" widget="many2many_tags"
                               domain="[('partner_id', '=', company_id.partner_id)]"
                               context="{'default_partner_id': company_id.partner_id}"
                               placeholder="All company bank accounts"/>
                    </setting>
                    <setting id="statement_aging" company_dependent="1" string="Aging Interval"
                             help="Days per aging column: 30 gives Not Due, 1-30, 31-60, 61-90, 91-120 and older">
                        <field name="statement_aging_interval"/> days
                    </setting>
                    <setting id="statement_letterhead" company_dependent="1" string="Letterhead"
                             help="Optional banner across the top of every statement page. Without it, statements use the company document layout.">
                        <field name="statement_header_image" widget="image" class="w-100" options="{'size': [0, 90]}"/>
                    </setting>
                    <setting id="statement_signature" company_dependent="1" string="Signature / Stamp"
                             help="Printed above 'Authorised Signatory'">
                        <field name="statement_signature" widget="image" options="{'size': [0, 90]}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
