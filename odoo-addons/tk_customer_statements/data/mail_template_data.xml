<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_customer_statement" model="mail.template">
            <field name="name">Customer Statement: Send by email</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ user.company_id.name }}: Statement of account for {{ object.commercial_partner_id.name }}</field>
            <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="partner_to">{{ object.address_get(['invoice'])['invoice'] }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="description">Sent to customers with their statement of account attached</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.name or ''">Azure Interior</t>,
        <br/><br/>
        Please find attached your statement of account with <t t-out="user.company_id.name or ''">YourCompany</t>.
        <br/><br/>
        If you have already settled the balance, please disregard this message and accept our thanks.
        Should any entry differ from your records, simply reply to this email and we will look into it.
        <br/><br/>
        Best regards,
        <t t-if="not is_html_empty(user.signature)">
            <br/><br/>
            <t t-out="user.signature or ''">--<br/>Mitchell Admin</t>
        </t>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
